# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the main model is rate limited or overloaded (each model has its own quota).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GITHUB_TOKEN=
PSI_API_KEY=
# UI development only: show the labelled sample review instead of calling the functions.
VITE_USE_FIXTURES=
