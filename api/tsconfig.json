{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "../src/shared/**/*.ts",
    "../scripts/**/*.ts"
  ],
  "exclude": [
    "../src/shared/**/*.test.ts"
  ]
}